);

const Contact = () => {
  return (
    <section id="contact">
      <div className="glass" style={{
        padding: '3rem',
        maxWidth: '700px',
        width: '100%',
        textAlign: 'center',
        display: 'flex',
        flexDirection: 'column',
        gap: '2rem'
      }}>
        <h2 className="text-gradient" style={{ fontSize: '3rem' }}>Get In Touch</h2>
        <p style={{ color: 'rgba(255,255,255,0.7)', fontSize: '1.1rem' }}>
          Interested in working together or just want to say hi? 
          Feel free to reach out on any of these platforms!
        </p>
        
        <div style={{ display: 'flex', justifyContent: 'center', gap: '2rem', flexWrap: 'wrap' }}>
          {[
            { icon: <Github />, label: 'GitHub', link: 'https://github.com/sudh2005/Badam-Sudheer-Reddy' },
            { icon: <Linkedin />, label: 'LinkedIn', link: 'https://linkedin.com/in/badam-sudheer-reddy-3028ab32b' },
            { icon: <Twitter />, label: 'Twitter', link: 'https://x.com/ba77461' },
            { icon: <Facebook />, label: 'Facebook', link: 'https://www.facebook.com/badampravallika' },
            { icon: <Mail />, label: 'Email', link: 'mailto:badamsudheerreddy@gmail.com' },
            { icon: <Phone />, label: 'Call', link: 'tel:8688509699' },
          ].map((item) => (
            <a 
              key={item.label}
              href={item.link}
              target="_blank"
              rel="noopener noreferrer"
              className="glass"
              style={{
                padding: '1rem',
                color: '#fff',
                display: 'flex',
                alignItems: 'center',
                gap: '0.5rem',
                textDecoration: 'none',
                transition: '0.3s'
              }}
              onMouseEnter={(e) => {
                e.currentTarget.style.borderColor = 'var(--primary-color)';
                e.currentTarget.classList.add('glow-shadow');
              }}
              onMouseLeave={(e) => {
                e.currentTarget.style.borderColor = 'var(--glass-border)';
                e.currentTarget.classList.remove('glow-shadow');
              }}
            >
              {item.icon}
              <span style={{ fontWeight: 600 }}>{item.label}</span>
            </a>
          ))}
        </div>
      </div>
    </section>
  );
};

export default Contact;
